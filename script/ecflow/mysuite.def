suite ecflow_tutorial_regnierc

  edit HOST fidjim05-sihpc
  edit USER regnierc
  edit REMOTEDIR /home/smer/regnierc/ecflow-jobs
  edit ECF_JOBOUT %REMOTEDIR%/%ECF_NAME%_R%YMD%-%ECF_DATE%-%TIME%.%ECF_TRYNO%

  edit ECF_FILES /home/smer/regnierc/code/ecflow-tutorial/ecflow_tutorial_regnierc
  edit ECF_INCLUDE /home/smer/regnierc/code/ecflow-tutorial

  edit TROIKA /home/smer/clavierm/miniconda3/envs/ecflow5/bin/troika
  edit TROIKA_CONFIG  /home/smer/regnierc/code/ecflow-tutorial/troika.yml
  edit ECF_JOB_CMD %TROIKA% -c %TROIKA_CONFIG% submit --user %USER% -o %ECF_JOBOUT% %HOST% %ECF_JOB%
  edit ECF_KILL_CMD %TROIKA% -c %TROIKA_CONFIG% kill -u %USER% %HOST% %ECF_JOB%
  edit ECF_STATUS_CMD %TROIKA% -c %TROIKA_CONFIG% monitor -u %USER% %HOST% %ECF_JOB%

  edit ECF_TRYNO 2

  edit OUTPUT_DIR /home/smer/regnierc/ecflow_tutorial_output

  family build_helloworld
	  repeat date YMD 20201126 20210228 7

	  task hello
	  task world
		edit HOST fidjim06-sihpc
		#trigger hello == complete
  endfamily

  family concat
	  repeat date YMD 20201126  20210228 7
	  trigger build_helloworld:YMD > concat:YMD

	  task hello_world
		edit HOST fidjim07-sihpc
	  #task display
		#edit HOST fidjim08-sihpc
		#trigger hello_world == complete
  endfamily

  family failandsucceed
	task marchepasbien
  endfamily

endsuite

