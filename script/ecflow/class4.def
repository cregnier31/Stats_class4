suite class4

   edit ECF_JOBOUT %REMOTEDIR%/%ECF_NAME%_R%YMD%-%ECF_DATE%-%TIME%.%ECF_TRYNO%
   edit ECF_FILES '/home/smer/regnierc/code/test/TEP_CLASS4_dev/script/ecflow'
   edit USER 'cregnier'
   edit HOST 'fidjim08-sihpc'
   edit REMOTEDIR '/home/smer/regnierc/ecflow-jobs'
   edit ECF_LOGHOST 'fidjim08-sihpc'
   edit ECF_LOGPORT '6666'
   edit TROIKA /home/smer/clavierm/miniconda3/envs/ecflow5/bin/troika
   edit TROIKA_CONFIG  /home/smer/regnierc/code/test/TEP_CLASS4_dev/script/ecflow/troika.yml
   edit ECF_JOB_CMD %TROIKA% -c %TROIKA_CONFIG% submit --user %USER% -o %ECF_JOBOUT% %HOST% %ECF_JOB%
   edit ECF_KILL_CMD %TROIKA% -c %TROIKA_CONFIG% kill -u %USER% %HOST% %ECF_JOB%
   edit ECF_STATUS_CMD %TROIKA% -c %TROIKA_CONFIG% monitor -u %USER% %HOST% %ECF_JOB%
   edit ECF_TRYNO 2

   repeat date JRUN 20210101 20210924 1

   family Pre
      task download
      task prout
         edit HOST px-155
         trigger download == complete
   endfamily

   family Proc
      trigger Pre == complete
      task toto
         edit TOTO 42
         edit HOST kara
         edit SLURM_PARTITION 'mono'
         edit SLURM_QOS 'normal'
         edit SLURM_NODES '1'
         edit SLURM_ELAPSE '00:05:00'
         edit SLURM_NTASKS '32'
      endtask
   endfamily

endsuite
 
