## Fonctions de base conversion jours-jours juliens CNES et inversement
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

function d2jm {

# translate date in format yYYYYmMMdDD to Julian day
   # routine C.REGNIER 09/2009
   date=`echo $1`
   YEAR=`echo $date | cut -c2-5`
   MONTH=`echo $date | cut -c7-8`
   DAY=`echo $date | cut -c10-11`
   date1=${YEAR}${MONTH}${DAY}
   date1j=`d2j $date1`
   echo $date1j
}

function j2dm {

# translate a Julian day in format yYYYYmMMdDD 
   # routine C.REGNIER 09/2009
   date=`j2d $1`
   YEAR=`echo $date | cut -c1-4`
   MONTH=`echo $date | cut -c5-6`
   DAY=`echo $date | cut -c7-8`
   date1=y${YEAR}m${MONTH}d${DAY}
   echo $date1
}

function d2j {
   
# translate std date to Julian day
   # routine Lucas Nouel
   typeset -i day month year tmpmonth tmpyear
   dateD=$1
   day=$(echo $dateD | cut -c7-8)
   month=$(echo $dateD | cut -c5-6)
   year=$( echo $dateD | cut -c1-4)
   ((tmpmonth = 12 * year + month - 3))
   ((tmpyear = tmpmonth / 12))
   val=$(( (734 * tmpmonth + 15) / 24 -  2 * tmpyear + tmpyear/4 - tmpyear/100 + tmpyear/400 + day - 712164 ))
   echo $val
}

function  j2d {
   # translate Julianday to std date
   # routine Lucas Nouel
   typeset -i day month year tmpday centuries
   typeset -Z2 day month
   ((tmpday = $1 + 712164))
   ((centuries = (4 * tmpday - 1) / 146097))
   ((tmpday += centuries - centuries/4))
   ((year = (4 * tmpday - 1) / 1461))
   ((tmpday -= (1461 * year) / 4))
   ((month = (10 * tmpday - 5) / 306))
   ((day = tmpday - (306 * month + 5) / 10))
   ((month += 2))
   ((year += month/12))
   ((month = month % 12 + 1))
   echo $year$month$day
}

## Fonctions de base conversion d'un TABLEAU jours-jours juliens CNES et inversement

function d2jtab {
   # translate std date to Julian day
   # routine C. REGNIER 11/2007 sort un tableau de jours juliens
   typeset -i day month year tmpmonth tmpyear
   jour=$*
   IND=1
   for i in $jour; do
   dateD=$i
   day=$(  echo $dateD | cut -c7-8)
   month=$(echo $dateD | cut -c5-6)
   year=$( echo $dateD | cut -c1-4)
   ((tmpmonth = 12 * year + month - 3))
   ((tmpyear = tmpmonth / 12))
   val=$(( (734 * tmpmonth + 15) / 24 -  2 * tmpyear + tmpyear/4 - tmpyear/100 + tmpyear/400 + day - 712164 ))
   tab[IND]=$val
   #echo $dateD $IND ${tab[IND]}
   let IND=IND+1
   done
   echo ${tab[*]}
}

function j2dtab {
 # translate Julian day table to std date
 typeset -i day month year tmpday centuries
 typeset -Z2 day month
 jour=$*
 IND=1
 for i in $jour; do
    dateD=$i
    ((tmpday = $dateD + 712164))
    ((centuries = (4 * tmpday - 1) / 146097))
    ((tmpday += centuries - centuries/4))
    ((year = (4 * tmpday - 1) / 1461))
    ((tmpday -= (1461 * year) / 4))
    ((month = (10 * tmpday - 5) / 306))
    ((day = tmpday - (306 * month + 5) / 10))
    ((month += 2))
    ((year += month/12))
    ((month = month %12 + 1))                                                                                                               
    val=$year$month$day
    tab[IND]=$val
    let IND=IND+1
 done
 echo ${tab[*]}
}

function quel_diff {
    # calcul la diff entre deux dates en arg . G.Vinay
    # Recup des dates :
    dB=$1 # 20030303
    dF=$2 # 20030305
    # Transfo des dates en JJ
    JdB=$(d2j $dB)
    JdF=$(d2j $dF)
    diffe=`echo "scale=0; $JdB-$JdF" | bc -l`
    echo ${diffe}
}

function isbisextil {
    # Indique si l'année est bisextile ou pas
    # C.REGNIER
    year=$1
    ((val=$year % 4))
    ((val2=$year % 100))
    ((val3=$year % 400))
    if [  $val -eq 0 -a $val2 -ne 0 -o $val3 -eq 0 ] 
    then
	var_out=1
    else
	var_out=0
    fi
    echo ${var_out}
}

