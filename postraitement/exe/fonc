function isBetween {
    # return "1" if between, else "0". G.Vinay/FMessal
    fic=$1
    date_t0=$2
    date_t1=$3
    date_fic=$(echo ${fic##*/} | awk -F"_" '{print $2}')
    difference_t0=$(quel_diff $date_t0 $date_fic)
    difference_t1=$(quel_diff $date_fic $date_t1)
    #echo $fic $date_t0 $date_t1 $difference_t0 $difference_t1
    zero=0
    one=1
    result=$one
    if test $difference_t0 -gt 0 
      then
      ((result=zero))
    fi
    if test $difference_t1 -gt 0 
      then
      ((result=zero))
    fi

    case $result in
        1)echo "1";;
        0)echo "0";;
    esac
}

function dim_zone {
