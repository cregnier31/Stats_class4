function isHindcast {
    # return "1" if Hindcast, else "0". G.Vinay/FMessal
    fic=$1
    date_F=$(echo ${fic##*/} | awk -F"_" '{print $3}')
    #echo ' date_F = ' $date_F
    date_B=$(echo ${fic##*/} | cut -d'_' -f6 | cut -c2-9) 
    #echo ' date_B = ' $date_B
    difference=$(quel_diff $date_B $date_F)
    case $difference in
        8|9|10|11|12|13|14)echo "1";;
        *)echo "0";;
    esac
}

