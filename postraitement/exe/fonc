function recherche {
    nb_val=`echo $#` 
    var=`echo $*`
    #echo $var
    var_ini=`d2j $(echo $1)`
    var_finale=`d2j $(echo $2)`
    #echo "Var " $var_ini $var_finale
    #echo $nb_val
    i2=0
 for i in `seq 3 $nb_val`;do
     let i2=$i-2
     chaine="awk '{print \$$i}'"
     date=`echo $var | eval $chaine`  
     jourj=`d2j $date`
     tab[$i2]=$jourj
 done
 ind_min=0
 ind_max=0
 let val=$nb_val-2
 let var_ini_7jrs=$var_ini+7
 let var_ini_14jrs=$var_ini+14
 let var_finale_7jrs=$var_finale+7
 let var_finale_14jrs=$var_finale+14
 ind=1
 var_min=0
 var_max=0

while [ $ind -le $val ]
do
    if [ ${tab[$ind]} -ge ${var_ini_7jrs} -a  ${tab[$ind]} -lt ${var_ini_14jrs} ]
    then
	var_min=$ind
    elif [ ${tab[$ind]} -ge ${var_finale_7jrs} -a ${tab[$ind]} -lt ${var_finale_14jrs} ]
    then
	var_max=$ind
    fi
    let ind=ind+1
done  
echo $var_min $var_max      
}
