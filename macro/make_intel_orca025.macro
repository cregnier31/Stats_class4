## ARCHIVE LIBRARY
AR=ar -rv
## NETCDF
LIBNETCDF=netcdf
NCDF_INC = ${NETCDF_INC}
NCDF_LIB = -L${NETCDF_LIB} -lnetcdf
INCLUDE_NC =  -I$(NCDF_INC)
LIB_NC=${NETCDF_LIB}/libnetcdf.a

# MFT
MFT_DIR=/home/cregnier/LIB/MFT3.6/intel
MFT_INC=${MFT_DIR}/include
MFT_LIB=${MFT_DIR}/lib
LIB_MFT=libmft.a
LIBMFT=mft
##
paramPath=${MFT_DIR}/param
INCLUDE= -I${NETCDF_INC} -I${MFT_INC}
LIBRARY=-L$(MFT_LIB) -lmft $(NCDF_LIB) 

##
MAKE=gmake
## Clé cpp
