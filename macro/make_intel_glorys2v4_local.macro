## ARCHIVE LIBRARY
AR=ar -rv
## NETCDF
LIBNETCDF=netcdf
NCDF_INC = ${NETCDF_INC}
NCDF_LIB = -L${NETCDF_LIB} -lnetcdff  -lnetcdf  -L${HDF5_LIB} #-lhdf5_hl -lhdf5
INCLUDE_NC =  -I$(NCDF_INC)
LIB_NC=${NETCDF_LIB}/libnetcdf.a

# MFT
MFT_DIR=/home/cregnier/LIB/MFT3.6/intel_hdf5/
MFT_INC=${MFT_DIR}/include
MFT_LIB=${MFT_DIR}/lib
LIB_MFT=libmft.a
LIBMFT=mft
##
paramPath=${MFT_DIR}/param
INCLUDE= -I${NETCDF_INC} -I${MFT_INC}
LIBRARY=-L$(MFT_LIB) -lmft $(NCDF_LIB) 

##
MAKE=gmake
## Clé cpp
CPP_KEYS=-Dkey_orca_r025 -Dkey_inv_prof -Dkey_red_profil -Dkey_global #-Dkey_debug  #-Dkey_test #-Dkey_debug #-Dkey_debuggeomlib  #-Dkey_computePot # -Dkey_debug
MODELE=GLORYS2V4
CONFIG=ORCA025
