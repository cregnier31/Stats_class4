# Compilo
F90=ifort
COMPILEPT=$(F90) -cpp
COMPILE=ifort
F90PT=ifort -cpp

## FLAGS
OPEN_MP=-openmp

## Compilation avec options de debug
#FFLAGS=-O0  -check bounds -ftrapuv -check uninit -check pointers -traceback -convert big_endian 
#LD_FLAGS=-O0  -check bounds -ftrapuv -check uninit -check pointers -traceback -convert big_endian

FFLAGS=-O3 -convert big_endian 
LD_FLAGS=-O3 -convert big_endian

## Compilation sans options de debug
#FFLAGS=-O3 -check bounds -convert big_endian 
#LD_FLAGS=-O3 -convert big_endian

#Compilation open mp
